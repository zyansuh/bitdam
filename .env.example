# Canonical REST key (Kakao OAuth client_id). Required at Vite build time.
VITE_KAKAO_REST_API_KEY=
# Optional aliases if the canonical name is missing (still baked in at build).
# VITE_KAKAO_API_KEY=
# VITE_KAKO_API_KEY=
VITE_KAKAO_JAVASCRIPT_KEY=
# Do not set VITE_KAKAO_REDIRECT_URI. The app uses the current site origin.
# Client Secret을 켠 경우에만. SPA에서는 콘솔에서 Secret을 끄는 편이 안전합니다.
VITE_KAKAO_CLIENT_SECRET=
# Optional. SPA builds expose this key — use a backend proxy in production.
# VITE_OPENAI_API_KEY=

